# ---- Backend (Spring Boot) ----
# Copy this file and export the variables before running the backend, e.g.:
#   cp .env.example .env   (then load it in your shell or IDE run configuration)
#
# IMPORTANT: .env files contain real credentials and must NEVER be committed.
# (.env is already git-ignored; this example uses placeholders only.)

# JDBC connection to the central PostgreSQL database
DATABASE_URL=jdbc:postgresql://localhost:5432/rosii_management
DATABASE_USERNAME=rosii
DATABASE_PASSWORD=change-me

# HTTP port of the backend REST API
SERVER_PORT=8080

# Flyway database migrations run at startup and require a reachable PostgreSQL.
# Set to false only for frontend/backend development without a database.
# FLYWAY_ENABLED=true

# JWT authentication (backend refuses to start without a strong secret).
# Generate one, e.g.: openssl rand -base64 48   (minimum 32 characters)
JWT_SECRET=replace-with-at-least-32-random-characters
# Access-token lifetime in seconds (or Duration style, e.g. 30m)
JWT_EXPIRATION=3600

# ---- Desktop (Tauri/Vite) ----
# Only VITE_-prefixed variables are exposed to the frontend bundle.
# Do NOT put secrets into VITE_ variables.
# VITE_API_BASE_URL=http://localhost:8080
